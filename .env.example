# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
# SQLite file location (created automatically)
DB_PATH=./data/school.db
# REQUIRED in production: 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_HOURS=8
# Set to false only when serving over plain http in production (e.g. a LAN demo)
COOKIE_SECURE=false
# Max login attempts per IP per 15 minutes
LOGIN_RATE_LIMIT=20
