{
  "name": "school-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "School Management System - modular monolith (Express + SQLite + React)",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "migrate": "node --env-file-if-exists=.env server/scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env server/scripts/seed.js",
    "db:reset": "node --env-file-if-exists=.env server/scripts/reset.js",
    "test": "node --test --test-concurrency=1 \"server/test/**/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.0"
  }
}
